# Copy to .env, read by `docker compose`. Never commit it.

# Version to run: changing this tag updates, or rolls back.
# Without this line, Compose builds the image from the repository.
ARCHIPEL_IMAGE=louischarnay/archipel:0.2.1

# Data folder, as an absolute path: database, app versions and secrets.
# It must exist before the first start. On macOS, keep it under your home folder.
ARCHIPEL_DATA_DIR=/Users/me/archipel-data

# Public address: the only one accepted in Host and Origin.
ARCHIPEL_PUBLIC_URL=http://localhost:3000

# Port and interface published on the machine. Keep 127.0.0.1 behind a reverse proxy.
ARCHIPEL_PORT=3000
ARCHIPEL_BIND=127.0.0.1

# Addresses of trusted reverse proxies, never a count.
# ARCHIPEL_TRUST_PROXY=172.16.0.0/12

# Encrypts the client secret and the database URL: openssl rand -hex 32
# Keep it apart from your data backups.
# ARCHIPEL_MASTER_KEY=

# Group of the Docker socket. 0 suits OrbStack and Docker Desktop.
# On Linux: stat -c %g /var/run/docker.sock
# DOCKER_SOCKET_GID=0

# Optional: locks the identity, otherwise it is set in the /setup wizard.
# OIDC_ISSUER=https://id.example
# OIDC_CLIENT_ID=archipel
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Pocket ID

