# Listening
HOST=127.0.0.1
PORT=3000

# Public address: the only one accepted in Host and Origin, which enables HSTS and __Host- cookies
# ARCHIPEL_PUBLIC_URL=https://archipel.example
# Addresses of trusted reverse proxies, never a count
# ARCHIPEL_TRUST_PROXY=10.0.0.2,172.16.0.0/12

# 32-byte key that encrypts the client secret and the database URL (openssl rand -hex 32)
# ARCHIPEL_MASTER_KEY_FILE=/run/secrets/archipel-master-key
